
const prompt = require("prompt-sync")();

let num = Number(prompt("Enter a 3-digit number: "));

let a = Math.floor(num / 100);
let b = Math.floor(num / 10) % 10;
let c = num % 10;

if (b > a && b > c) {
    console.log("Middle digit is the largest");
} else if (b < a && b < c) {
    console.log("Middle digit is the smallest");
} else {
    console.log("Middle digit is neither");
}

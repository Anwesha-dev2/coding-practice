
const prompt = require("prompt-sync")();

let num = Number(prompt("Enter a 3-digit number: "));

let a = Math.floor(num / 100);
let b = Math.floor(num / 10) % 10;
let c = num % 10;

if (a !== b && b !== c && a !== c) {
    console.log("All digits are distinct");
} else {
    console.log("Digits are not distinct");
}

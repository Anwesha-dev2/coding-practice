const readline = require("readline");

const r1 = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

r1.question("Enter marks: ", (input) => {

    let marks = Number(input);

    if (marks < 0 || marks > 100) {
        console.log("Invalid Marks");
    }
    else if (marks >= 90) {
        console.log("Grade A");
    }
    else if (marks >= 80) {
        console.log("Grade B");
    }
    else if (marks >= 70) {
        console.log("Grade C");
    }
    else if (marks >= 60) {
        console.log("Grade D");
    }
    else {
        console.log("Grade F");
    }

    r1.close();
});

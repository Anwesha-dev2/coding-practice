const readline = require("readline");

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

rl.question("Enter a Number: ", (input) => {

    let num = Number(input);

    if (num % 5 === 0)
        console.log("Divisible by 5");
    else
        console.log("Not Divisible by 5");

    rl.close();
});

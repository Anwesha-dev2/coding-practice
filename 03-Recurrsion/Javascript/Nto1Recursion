const readline = require("readline");

const r1 = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

r1.question("Enter n: ", (input) => {
    let n = Number(input);

    function printNumbers(n) {
        if (n === 0)
            return;

        process.stdout.write(n + " ");
        printNumbers(n - 1);
    }

    printNumbers(n);
    r1.close();
});

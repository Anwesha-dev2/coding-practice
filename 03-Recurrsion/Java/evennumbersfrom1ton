import java.util.Scanner;

public class Main {
    static void printEven(int n) {
        if (n < 2)
            return;

        printEven(n - 1);

        if (n % 2 == 0)
            System.out.print(n + " ");
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter n: ");
        int n = scanner.nextInt();

        printEven(n);
        scanner.close();
    }
}
